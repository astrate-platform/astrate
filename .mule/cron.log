// AsyncOperation reports whether the mutating endpoint request asked for
// asynchronous execution via the upstream `?async_operation=` parameter.
// Astrate is always-synchronous (design; see COMPATIBILITY async deviation),
// so handlers must accept the parameter and ignore it: false (upstream's
// opt-in to sync, Astrate's only mode), true, and unparseable values all
// leave behaviour unchanged. It exists to make that acceptance explicit and
// to keep the parameter from being flag-marshalled anywhere by accident.
func AsyncOperation(r *http.Request) bool {
    switch strings.ToLower(r.URL.Query().Get("async_operation")) {
    case "true":
        return true
    default:
        return false
    }
}
```

